    "Validation": {
      "properties": {
        "numeric_violations_fixed": {
          "title": "Numeric Violations Fixed",
          "type": "integer"
        },
        "sentences_removed": {
          "items": {
            "type": "string"
          },
          "title": "Sentences Removed",
          "type": "array"
        },
        "unresolved_validator_issues": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Validator Issues",
          "type": "array"
        },
        "validator_issues": {
          "items": {
            "type": "string"
          },
          "title": "Validator Issues",
          "type": "array"
        }
