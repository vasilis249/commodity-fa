        },
        "dir_acc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dir Acc"
        },
        "dir_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dir P"
        },
        "dm_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dm P"
        },
        "dm_p_adj": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dm P Adj"
        },
        "edge": {
          "title": "Edge",
          "type": "boolean"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "skill_vs_naive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skill Vs Naive"
        },
        "verdict": {
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "model",
        "skill_vs_naive",
        "coverage",
        "dir_acc",
        "dir_p",
        "dm_p",
        "dm_p_adj",
        "edge",
        "verdict"
      ],
      "title": "SkillLine",
      "type": "object"
